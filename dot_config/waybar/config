{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/voxtype", "pulseaudio", "network", "tray"],
    "custom/voxtype": {
        "exec-if": "test -x \"$HOME/.local/bin/voxtype\"",
        "exec": "\"$HOME/.local/bin/voxtype\" status --follow --format json",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "idle": "",
            "stopped": "",
            "recording": "● REC",
            "transcribing": "Transcribing…"
        },
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },
    "clock": {
        "format": "{:%I:%M %p  %A %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": " Connected",
        "format-disconnected": "⚠ Disconnected"
    },
}
