#
# ~/.bashrc
#

# If not running interactively, don't do anything


[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

function wal() {
    if [ -z "$1" ]; then
        echo "Usage: wal <path/to/image>"
        return 1
    fi

    local img=$(readlink -f "$1")
    if [ ! -f "$img" ]; then
        echo "wal: image not found: $1" >&2
        return 1
    fi

    # Hyprpaper 0.8 loads images directly; preload/unload IPC was removed.
    local monitor
    for monitor in $(hyprctl monitors | awk '/^Monitor / {print $2}'); do
        hyprctl hyprpaper wallpaper "$monitor,$img,cover" || return 1
    done

    cat > ~/.config/hypr/hyprpaper.conf <<EOF
wallpaper {
    monitor =
    path = $img
    fit_mode = cover
}
splash = false
EOF

    wallust run "$img" || return 1
    killall -SIGUSR2 waybar
    hyprctl reload
}


function vf() {
    local file="$1"
    # 1. Use grep to get line numbers
    # 2. Use fzf to let you search (with a preview window on the right)
    # 3. Cut just the line number
    local line=$(grep -n "" "$file" | fzf --delimiter ':' --preview 'bat --style=numbers --color=always --highlight-line {1} '"$file"'' | cut -d: -f1)
    
    # 4. If you selected a line, open nano to that exact spot
    if [ -n "$line" ]; then
        nano +$line "$file"
    fi
}
