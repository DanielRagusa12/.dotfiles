#
# ~/.bashrc
#

# If not running interactively, don't do anything


[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

function wal() {
    local img=$(readlink -f "$1")

    # 1. Preload image
    hyprctl hyprpaper preload "$img"

    # 2. LOOP: Apply to DP-1, DP-2, etc. individually
    for monitor in $(hyprctl monitors | grep "Monitor" | awk '{print $2}'); do
        hyprctl hyprpaper wallpaper "$monitor,$img"
    done

    # 3. Save "wildcard" config for next reboot (Simpler for startup)
    cat > ~/.config/hypr/hyprpaper.conf <<EOF
preload = $img
wallpaper = ,$img
splash = false
EOF

    # 4. Clean up RAM and reload themes
    hyprctl hyprpaper unload unused
    wallust run "$img"
    killall -SIGUSR2 waybar
    hyprctl reload
}


function vf() {
    local file="$1"
    # 1. Use grep to get line numbers
    # 2. Use fzf to let you search (with a preview window on the right)
    # 3. Cut just the line number
    local line=$(grep -n "" "$file" | fzf --delimiter ':' --preview 'bat --style=numbers --color=always --highlight-line {1} '"$file"'' | cut -d: -f1)
    
    # 4. If you selected a line, open nano to that exact spot
    if [ -n "$line" ]; then
        nano +$line "$file"
    fi
}
