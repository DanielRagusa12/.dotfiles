# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

#SSH SOCKET
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Theme - robbyrussell provides the ➜ and git status
ZSH_THEME="robbyrussell"

# Plugins list (Use native OMZ git plugin)
plugins=(git)

# Load Oh My Zsh (This sets the prompt)
source $ZSH/oh-my-zsh.sh

# --- Arch Manual Plugin Loading ---
# We source these AFTER oh-my-zsh so they don't get overwritten
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
#source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# --- Interaction & History ---
setopt AUTO_CD
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000

# --- Aliases ---
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias copy="kitty +kitten clipboard"

# --- Custom Functions ---

# Wallpaper & Theme Switcher
function wal() {
    if [ -z "$1" ]; then
        echo "Usage: wal <path/to/image>"
        return 1
    fi

    local img=$(readlink -f "$1")
    if [ ! -f "$img" ]; then
        echo "wal: image not found: $1" >&2
        return 1
    fi

    # Hyprpaper 0.8 loads images directly; preload/unload IPC was removed.
    local monitor
    for monitor in $(hyprctl monitors | awk '/^Monitor / {print $2}'); do
        hyprctl hyprpaper wallpaper "$monitor,$img,cover" || return 1
    done

    cat > ~/.config/hypr/hyprpaper.conf <<EOF
wallpaper {
    monitor =
    path = $img
    fit_mode = cover
}
splash = false
EOF

    wallust run "$img" || return 1
    killall -SIGUSR2 waybar
    hyprctl reload
}

# Fast File Search & Edit (fzf + bat + nano)
function vf() {
    local file="$1"
    local line=$(grep -n "" "$file" | fzf --delimiter ':' --preview 'bat --style=numbers --color=always --highlight-line {1} '"$file"'' | cut -d: -f1)
    if [ -n "$line" ]; then
        nano +$line "$file"
    fi
}

function codeline() {
    local dep file selection line fd_cmd
    local missing=()

    for dep in fzf rg bat code; do
      command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done

    if command -v fd >/dev/null 2>&1; then
      fd_cmd=fd
    elif command -v fdfind >/dev/null 2>&1; then
      fd_cmd=fdfind
    else
      missing+=("fd")
    fi

    if ((${#missing[@]})); then
      printf 'codeline: missing required commands:\n' >&2
      printf '  - %s\n' "${missing[@]}" >&2
      return 1
    fi

    file=$(
      "$fd_cmd" --type f --hidden --exclude .git |
        fzf --preview 'bat --color=always --style=numbers --line-range=:500 -- {}'
    ) || return

    selection=$(
      FILE="$file" fzf \
        --delimiter=: \
        --preview 'bat --color=always --style=numbers --highlight-line {1} --line-range {1}:+20 -- "$FILE"' \
        < <(rg --line-number --no-heading '^' -- "$file")
    ) || return

    line=${selection%%:*}
    code --goto "$file:$line"
}



# --- ENV Vars ---
export PATH=~/.npm-global/bin:$PATH

export PYENV_ROOT="$HOME/.pyenv"
if [[ -d $PYENV_ROOT/bin ]]; then
    export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init - zsh)"
fi

