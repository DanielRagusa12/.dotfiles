# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

#SSH SOCKET
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Theme - robbyrussell provides the ➜ and git status
ZSH_THEME="robbyrussell"

# Plugins list (Use native OMZ git plugin)
plugins=(git)

# Load Oh My Zsh (This sets the prompt)
source $ZSH/oh-my-zsh.sh

# --- Arch Manual Plugin Loading ---
# We source these AFTER oh-my-zsh so they don't get overwritten
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
#source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# --- Interaction & History ---
setopt AUTO_CD
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000

# --- Aliases ---
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias copy="kitty +kitten clipboard"

# --- Custom Functions ---

# Wallpaper & Theme Switcher
function wal() {
    # 0. Validate Input
    if [ -z "$1" ]; then
        echo "Usage: wal <path/to/image>"
        return 1
    fi

    local img=$(readlink -f "$1")
    
    # 1. Update Wallpaper (Hyprland)
    hyprctl hyprpaper preload "$img"
    
    for monitor in $(hyprctl monitors | grep "Monitor" | awk '{print $2}'); do
        hyprctl hyprpaper wallpaper "$monitor,$img"
    done
    
    # Write config for persistence
    cat > ~/.config/hypr/hyprpaper.conf <<EOF
preload = $img
wallpaper = ,$img
splash = false
EOF
    
    hyprctl hyprpaper unload unused

    # 2. Generate Colors (Wallust)
    # This generates ~/.config/nvim/lua/wallust_colors.lua (based on our previous setup)
    wallust run "$img"

    # 3. Reload Applications
    # Reload Waybar
    killall -SIGUSR2 waybar
    
    # Reload Hyprland Config
    hyprctl reload
}

# Fast File Search & Edit (fzf + bat + nano)
function vf() {
    local file="$1"
    local line=$(grep -n "" "$file" | fzf --delimiter ':' --preview 'bat --style=numbers --color=always --highlight-line {1} '"$file"'' | cut -d: -f1)
    if [ -n "$line" ]; then
        nano +$line "$file"
    fi
}



# --- ENV Vars ---
export PATH=~/.npm-global/bin:$PATH

export PYENV_ROOT="$HOME/.pyenv"
if [[ -d $PYENV_ROOT/bin ]]; then
    export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init - zsh)"
fi

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
